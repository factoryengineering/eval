{
  "name": "warehouse-shipment",
  "collectionRoute": "/api/shipments",
  "parent": {
    "collectionRoute": "/api/warehouses",
    "childCollectionRoute": "/api/warehouses/{warehouseId}/shipments",
    "parentBodyField": "warehouseId",
    "writableFields": [
      { "name": "code", "jsonType": "string", "clrType": "System.String", "samples": ["WH-NORTH", "WH-SOUTH", "WH-EAST"] },
      { "name": "capacityCubicMeters", "jsonType": "number", "clrType": "System.Int32", "samples": [1200, 800, 4500] }
    ]
  },
  "writableFields": [
    { "name": "reference", "jsonType": "string", "clrType": "System.String", "samples": ["SHP-0001", "SHP-0002", "SHP-0003"] },
    { "name": "weightKg", "jsonType": "number", "clrType": "System.Decimal", "samples": [12.50, 3.2, 100] },
    { "name": "fragile", "jsonType": "boolean", "clrType": "System.Boolean", "samples": [true, false] }
  ],
  "serverOwnedFields": ["downloadCount", "lastAuditAt"],
  "serverOwned": [
    { "field": "downloadCount", "entityTypeName": "Consignment" },
    { "field": "lastAuditAt", "entityTypeName": "Depot", "kind": "timestamp", "owner": "parent" }
  ]
}
